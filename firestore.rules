rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ---------------------------------------------------------
    // GLOBAL HELPERS
    // ---------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // ---------------------------------------------------------
    // VALIDATION BLUEPRINTS
    // ---------------------------------------------------------
    function isValidResearch(data) {
      return data.userId == request.auth.uid
        && data.title is string && data.title.size() <= 500
        && data.query is string && data.query.size() <= 2000
        && data.depth in ['quick', 'standard', 'deep']
        && data.status in ['pending', 'in_progress', 'completed', 'failed']
        && (data.get('report', null) == null || data.report is string)
        && (data.get('summary', null) == null || data.summary is string && data.summary.size() <= 5000)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSource(data) {
      return data.userId == request.auth.uid
        && data.title is string && data.title.size() <= 1000
        && data.url is string && data.url.size() <= 2048
        && (data.get('snippet', null) == null || data.snippet is string && data.snippet.size() <= 5000)
        && (data.get('favicon', null) == null || data.favicon is string)
        && data.createdAt is timestamp;
    }

    function isValidMessage(data) {
      return data.userId == request.auth.uid
        && data.role in ['user', 'assistant']
        && data.content is string && data.content.size() <= 10000
        && data.createdAt is timestamp;
    }

    function isValidProfile(data) {
      return data.email is string && data.email.size() <= 256
        && (data.fullName == null || data.fullName is string && data.fullName.size() <= 200)
        && (data.avatarUrl == null || data.avatarUrl is string);
    }

    // ---------------------------------------------------------
    // SECURITY RULES
    // ---------------------------------------------------------
    
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Researches
    match /researches/{researchId} {
      allow get: if isOwner(existing().userId);
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidResearch(incoming()) && incoming().createdAt == request.time;
      allow update: if isOwner(existing().userId) && isValidResearch(incoming()) && incoming().updatedAt == request.time && incoming().createdAt == existing().createdAt;
      allow delete: if isOwner(existing().userId);

      // Sources Subcollection
      match /sources/{sourceId} {
        allow read: if isOwner(resource.data.userId);
        allow create: if isSignedIn() && isValidSource(incoming()) && incoming().createdAt == request.time;
      }

      // Messages Subcollection
      match /messages/{messageId} {
        allow read: if isOwner(resource.data.userId);
        allow create: if isSignedIn() && isValidMessage(incoming()) && incoming().createdAt == request.time;
      }
    }

    // Profiles
    match /profiles/{userId} {
      allow get: if isSignedIn();
      allow create, update: if isOwner(userId) && isValidProfile(incoming());
    }
  }
}
