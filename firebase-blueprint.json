{
  "entities": {
    "Research": {
      "title": "Research",
      "description": "A research task and its generated report",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "The UID of the user who created the research" },
        "title": { "type": "string", "maxLength": 500 },
        "query": { "type": "string", "maxLength": 2000 },
        "depth": { "type": "string", "enum": ["quick", "standard", "deep"] },
        "status": { "type": "string", "enum": ["pending", "in_progress", "completed", "failed"] },
        "report": { "type": "string" },
        "summary": { "type": "string", "maxLength": 5000 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "title", "query", "depth", "status", "createdAt", "updatedAt"]
    },
    "Source": {
      "title": "Source",
      "description": "A web source used in research",
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 1000 },
        "url": { "type": "string", "format": "uri" },
        "snippet": { "type": "string", "maxLength": 5000 },
        "favicon": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "url", "createdAt"]
    },
    "Message": {
      "title": "Message",
      "description": "A message in a follow-up chat",
      "type": "object",
      "properties": {
        "role": { "type": "string", "enum": ["user", "assistant"] },
        "content": { "type": "string", "maxLength": 10000 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["role", "content", "createdAt"]
    },
    "Profile": {
      "title": "Profile",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "email": { "type": "string", "format": "email" },
        "fullName": { "type": "string", "maxLength": 200 },
        "avatarUrl": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "createdAt"]
    }
  },
  "firestore": {
    "/researches/{researchId}": {
      "schema": "Research",
      "description": "Main research documents"
    },
    "/researches/{researchId}/sources/{sourceId}": {
      "schema": "Source",
      "description": "Web sources associated with a research"
    },
    "/researches/{researchId}/messages/{messageId}": {
      "schema": "Message",
      "description": "Chat messages for a research"
    },
    "/profiles/{userId}": {
      "schema": "Profile",
      "description": "User profiles"
    }
  }
}
